# Server Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (Use MongoDB Atlas M0 Free cluster or above)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/institutehub?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Super Admin Initial Credentials (for seed script)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=superadmin@institutehub.com
ADMIN_PASSWORD=SuperAdminPass@2026#Secure
